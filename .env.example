NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# PostgreSQL connection used by the API.
DATABASE_URL=postgresql://handcraft:change-me@localhost:55432/handcraft

SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# 低余量与临期提醒扫描调度（规则可在「提醒调度」页面修改；这里仅控制进程内扫描器）
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCAN_INTERVAL_MS=300000
LOG_LEVEL=info
TZ=Asia/Shanghai
